[Unit]
Description=PatriotPot independent immutable S3 evidence archive
After=network-online.target cowrie.service
Wants=network-online.target

[Service]
Type=oneshot
User=patriot-archive
Group=patriot-archive
SupplementaryGroups=cowrie
EnvironmentFile=/etc/patriotpot/archive.env
Environment=HOME=/var/lib/patriotpot-archive
ExecStart=/opt/patriotpot-archive/venv/bin/python /usr/local/libexec/patriotpot-s3-archive.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadOnlyDirectories=/opt/cowrie/var/log/cowrie
ReadWriteDirectories=/var/lib/patriotpot-archive /var/log/patriotpot
CapabilityBoundingSet=
