[Unit]
Description=PatriotPot local Cowrie JSON Discord monitor
After=network-online.target cowrie.service
Wants=network-online.target

[Service]
Type=simple
User=patriot-discord
Group=patriot-discord
SupplementaryGroups=cowrie
EnvironmentFile=/etc/patriotpot/discord.env
Environment=HOME=/var/lib/patriotpot-discord
ExecStart=/opt/python/3.8.20/bin/python3.8 /usr/local/libexec/patriotpot-discord-monitor.py
Restart=always
RestartSec=5s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadOnlyDirectories=/opt/cowrie/var/log/cowrie
ReadWriteDirectories=/var/lib/patriotpot-discord /var/log/patriotpot
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
